spring.application.name=gateway
server.port=8080

eureka.client.service-url.defaultZone=http://localhost:8761/eureka
eureka.client.register-with-eureka=true
eureka.client.fetch-registry=true

spring.cloud.gateway.mvc.routes[0].id=student-service
spring.cloud.gateway.mvc.routes[0].uri=lb://student-service
spring.cloud.gateway.mvc.routes[0].predicates[0]=Path=/students/**

spring.cloud.gateway.mvc.routes[1].id=attendance-service
spring.cloud.gateway.mvc.routes[1].uri=lb://attendance-service
spring.cloud.gateway.mvc.routes[1].predicates[0]=Path=/attendance/**

spring.cloud.gateway.mvc.routes[2].id=result-service
spring.cloud.gateway.mvc.routes[2].uri=lb://result-service
spring.cloud.gateway.mvc.routes[2].predicates[0]=Path=/results/**

spring.cloud.gateway.mvc.routes[3].id=auth-service
spring.cloud.gateway.mvc.routes[3].uri=lb://auth-service
spring.cloud.gateway.mvc.routes[3].predicates[0]=Path=/auth/**